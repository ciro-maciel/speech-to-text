{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speech to Text",
  "version": "../package.json",
  "identifier": "click.ciromaciel.speech-to-text",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Speech to Text",
        "width": 1,
        "height": 1,
        "x": 0,
        "y": 0,
        "resizable": true,
        "maximizable": false,
        "visible": true,
        "focus": false,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Light",
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "useHttpsScheme": true
      },
      {
        "label": "overlay",
        "title": "Overlay",
        "url": "overlay-visualizer.html",
        "width": 440,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "visible": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "../entitlements.mac.plist"
    },
    "externalBin": [
      "whisper-cli",
      "whisper-server"
    ],
    "resources": {
      "resources/ggml-silero-v6.2.0.bin": "ggml-silero-v6.2.0.bin"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCQUVBM0E4ODFBMzZERTcKUldUbmJhT0JxS091MndWeWdnMzVjSUtFbWRHb0FEa0pzT0ZzNEliQWlvQ1BkWTdBYXZ2bE94ekYK",
      "endpoints": [
        "https://blob.ciromaciel.click/tools/speech-to-text/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
